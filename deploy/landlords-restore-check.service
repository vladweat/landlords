[Unit]
Description=Verify the latest Landlords backup in isolated PostgreSQL
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/landlords-backup.conf
ExecStart=/bin/bash ${PROJECT_DIR}/deploy/restore-check-landlords.sh
Nice=10
IOSchedulingClass=best-effort
TimeoutStartSec=30min
