# Контекст сборки — корень репозитория (docker compose build nginx).
# Не тащить секреты и тяжёлые артефакты в online-сборка бэкенда / nginx.

.git/
**/.git/

# Секреты
.env
backend/.env
**/.env

# Python
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Frontend: nginx использует заранее собранный dist; node_modules не нужны.
frontend/node_modules/
frontend/.vite/

# Документы и локальные данные
storage/
*.log

# Тесты не нужны в runtime-образе API (online всё равно ставит deps из requirements)
# backend/tests/ — оставляем возможность COPY при необходимости; не копируются Dockerfile'ом
