# Скопируй в backend/.env для API/Celery.
# Для подстановки в docker-compose скопируй также в корневой .env
# (или задай те же переменные в окружении).

# --- Приложение ---
APP_NAME=Landlords
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me
FRONTEND_URL=http://localhost:3000
# Публичный POST /v1/auth/register. По умолчанию закрыта; для интервью-демо включи true.
ALLOW_PUBLIC_REGISTRATION=false

# В production задай уникальный SECRET_KEY и APP_ENV=production.
# Дефолтный SECRET_KEY при APP_ENV=production запрещён.

# --- Postgres (те же имена, что у API) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landlords_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=landlords:
# Compose host-only secret files (not committed or synchronized).
REDIS_ACL_FILE=./secrets/redis/users.acl
REDIS_API_PASSWORD_FILE=./secrets/redis/api.password
REDIS_WORKER_PASSWORD_FILE=./secrets/redis/worker.password
REDIS_FLOWER_PASSWORD_FILE=./secrets/redis/flower.password

# --- Transactional outbox ---
OUTBOX_RELAY_POLL_SECONDS=2
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_LEASE_SECONDS=300
OUTBOX_RELAY_MAX_ATTEMPTS=12
OUTBOX_RELAY_BASE_BACKOFF_SECONDS=2
OUTBOX_RELAY_MAX_BACKOFF_SECONDS=300
OUTBOX_TASK_MAX_FAILURES=5

# --- Почта ---
# Вариант A: Resend (достаточно API-ключа; SMTP подставится сам)
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_TLS_MODE=starttls  # варианты: starttls, ssl; none только для локальной разработки
# SMTP_FROM=Landlords <noreply@your.domain>

# Вариант B: любой SMTP вручную (имеет приоритет над Resend)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM=Landlords <noreply@your.domain>

# Без provider письма пишутся в storage/emails/ только вне production.
# В production provider обязателен; SMTP TLS mode none запрещён.

# --- Логирование ---
LOG_LEVEL=INFO

# --- ЮKassa (SaaS billing, test/demo) — docs/BILLING.md ---
# Демо-магазин; secret с test_. Первая оплата работает через return+confirm без ngrok.
# Webhook (опционально): https://<ngrok>/api/v1/billing/webhooks/yookassa
# Карта без 3DS: 5555 5555 5555 4444
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=http://localhost:3000/settings?billing=return
BILLING_PRO_PRICE_RUB=990
BILLING_GRACE_DAYS=3

# --- Поддержка ---
SUPPORT_EMAIL=support@landlords.ru

# --- Наблюдаемость ---
# SENTRY_DSN=
# STATUS_INCIDENTS_PATH=/app/storage/status/incidents.json
# OPS_DISK_MIN_FREE_MB=500
# OPS_BEAT_STALE_HOURS=26
# DOCUMENTS_STORAGE_DIR=/app/storage/documents
