# Скопируй в backend/.env для API/Celery.
# Для подстановки в docker-compose скопируй также в корневой .env
# (или задай те же переменные в окружении).

# --- Приложение ---
APP_NAME=Landlords
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me
FRONTEND_URL=http://localhost:3000
# Публичный POST /v1/auth/register. Для портфолио/прода — false (CLI seed не зависит от флага).
ALLOW_PUBLIC_REGISTRATION=false

# В production задай уникальный SECRET_KEY и APP_ENV=production.
# Дефолтный SECRET_KEY при APP_ENV=production запрещён.

# --- Postgres (те же имена, что у API) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landlords_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- Почта ---
# Вариант A: Resend (достаточно API-ключа; SMTP подставится сам)
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=Landlords <noreply@your.domain>

# Вариант B: любой SMTP вручную (имеет приоритет над Resend)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM=Landlords <noreply@your.domain>

# Без SMTP_HOST и без RESEND_API_KEY письма пишутся в storage/emails/

# --- Логирование ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- ЮKassa (SaaS billing, test/demo) — docs/BILLING.md ---
# Демо-магазин; secret с test_. Первая оплата работает через return+confirm без ngrok.
# Webhook (опционально): https://<ngrok>/api/v1/billing/webhooks/yookassa
# Карта без 3DS: 5555 5555 5555 4444
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=http://localhost:3000/settings?billing=return
BILLING_PRO_PRICE_RUB=990
BILLING_GRACE_DAYS=3

# --- Поддержка ---
SUPPORT_EMAIL=support@landlords.ru

# --- Наблюдаемость ---
# SENTRY_DSN=
# STATUS_INCIDENTS_PATH=/app/storage/status/incidents.json
# OPS_DISK_MIN_FREE_MB=500
# OPS_BEAT_STALE_HOURS=26
# DOCUMENTS_STORAGE_DIR=/app/storage/documents
