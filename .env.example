# Скопируй в backend/.env для API/Celery.
# Для подстановки в docker-compose скопируй также в корневой .env
# (или задай те же переменные в окружении).

# --- Приложение ---
APP_ENV=development
DEBUG=true
SECRET_KEY=3AVX96Lo0ZGE_mqzA9pqzzYOmKHMB2Sh4wfSwKOFkFk
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# В production задай уникальный SECRET_KEY и APP_ENV=production.
# Дефолтный SECRET_KEY при APP_ENV=production запрещён.

# --- Postgres (те же имена, что у API) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landlords_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

